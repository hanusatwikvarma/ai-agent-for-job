# ----- Infra -----
MONGO_USER=jobagent
MONGO_PASSWORD=jobagent

# ----- Claude API -----
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Mail (defaults wired to Mailhog in docker-compose) -----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=job-agent@local.test

# ----- User identity -----
USER_EMAIL=you@example.com

# ----- Scraper -----
SCRAPE_CRON=0 0 */3 * * *     # every 3 hours
SCRAPE_KEYWORDS=java,spring boot,backend
SCRAPE_LOCATIONS=remote,bangalore

# ----- Submitter safety -----
# When true, the submitter opens a browser, fills the form, and STOPS before clicking submit.
SUBMITTER_DRY_RUN=true